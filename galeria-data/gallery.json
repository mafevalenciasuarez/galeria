        "duration_s": 3.2,
        "ease": "power2.inOut",
        "reduced_motion": "cut",
        "demo": "cube-demo.html",
        "note": "Esquina exterior (cubo): la pared siguiente sale de la arista derecha de la anterior y se aleja del espectador. La cámara rodea la arista en un arco mientras gira a la izquierda."
      },
      {
        "id": "seg-3",
        "type": "straight",
        "walls": [
          "wall-04-ai-training",
          "wall-05-reflexion"
        ]
      }
    ],
