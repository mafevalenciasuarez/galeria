        "duration_s": 2.8,
        "ease": "power2.inOut",
        "pull_back": 0.1,
        "reduced_motion": "cut",
        "demo": "corner-demo.html"
      },
      {
        "id": "seg-2",
        "type": "straight",
        "walls": [
          "wall-03-augmented-reality"
        ]
      },
      {
        "id": "corner-2",
        "type": "corner_90_outside",
        "direction": "left",
        "between": [
          "wall-03-augmented-reality",
          "wall-04-ai-training"
